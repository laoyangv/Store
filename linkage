using System;
using System.Collections.Generic;
using System.Linq;

public static class HierarchicalClustering
{
    /// <summary>
    /// 层次聚类。输入一维观测数组，返回 (n-1) x 4 的 linkage 矩阵 Z。
    /// Z 每行 = [idx1, idx2, distance, sample_count]，idx1 &lt; idx2。
    /// method: single / complete / average / weighted / centroid / median / ward
    /// </summary>
    public static double[,] Linkage(double[] x, string method = "single")
    {
        if (x == null) throw new ArgumentNullException(nameof(x));
        int n = x.Length;
        if (n < 2) throw new ArgumentException("至少需要 2 个样本");

        string m = method.ToLowerInvariant();
        var valid = new[] { "single", "complete", "average", "weighted", "centroid", "median", "ward" };
        if (!valid.Contains(m)) throw new ArgumentException($"不支持的 method: {method}");

        int maxId = 2 * n - 1;
        double[,] D = new double[maxId, maxId];   // 距离矩阵（对称）
        int[] size = new int[maxId];

        for (int i = 0; i < n; i++)
        {
            size[i] = 1;
            for (int j = 0; j < n; j++)
                D[i, j] = Math.Abs(x[i] - x[j]);
        }

        double[,] Z = new double[n - 1, 4];
        List<int> active = new List<int>(n);
        for (int i = 0; i < n; i++) active.Add(i);

        for (int step = 0; step < n - 1; step++)
        {
            // ---- 找最小距离对 ----
            double minD = double.MaxValue;
            int bestA = -1, bestB = -1;
            for (int p = 0; p < active.Count; p++)
            {
                for (int q = p + 1; q < active.Count; q++)
                {
                    int a = active[p], b = active[q];
                    if (D[a, b] < minD)
                    {
                        minD = D[a, b];
                        bestA = a;
                        bestB = b;
                    }
                }
            }

            int newId = n + step;
            size[newId] = size[bestA] + size[bestB];

            // ---- 记录 Z（scipy 规则：小 id 在前）----
            Z[step, 0] = bestA;
            Z[step, 1] = bestB;
            Z[step, 2] = minD;
            Z[step, 3] = size[newId];

            int si = size[bestA], sj = size[bestB], sk = si + sj;
            double dij = minD;

            // ---- Lance-Williams 递推更新 ----
            foreach (int k in active)
            {
                if (k == bestA || k == bestB) continue;
                double dki = D[k, bestA];
                double dkj = D[k, bestB];
                double dnew;
                switch (m)
                {
                    case "single":
                        dnew = Math.Min(dki, dkj);
                        break;
                    case "complete":
                        dnew = Math.Max(dki, dkj);
                        break;
                    case "average":
                        dnew = (si * dki + sj * dkj) / sk;
                        break;
                    case "weighted":
                        dnew = (dki + dkj) / 2.0;
                        break;
                    case "centroid":
                        dnew = Math.Sqrt(Math.Max(
                            (si * dki * dki + sj * dkj * dkj) / sk
                            - (double)si * sj * dij * dij / ((double)sk * sk), 0));
                        break;
                    case "median":
                        dnew = Math.Sqrt(Math.Max(
                            dki * dki / 2.0 + dkj * dkj / 2.0 - dij * dij / 4.0, 0));
                        break;
                    case "ward":
                        {
                            int skk = size[k];
                            double num = (skk + si) * dki * dki
                                       + (skk + sj) * dkj * dkj
                                       - skk * dij * dij;
                            double den = skk + sk;
                            dnew = Math.Sqrt(Math.Max(num / den, 0));
                            break;
                        }
                    default:
                        throw new ArgumentException();
                }
                D[k, newId] = D[newId, k] = dnew;
            }

            active.Remove(bestA);
            active.Remove(bestB);
            active.Add(newId);
        }

        return Z;
    }

    /// <summary>
    /// 切割层次聚类树，返回每个样本的簇标签（1 开始）。
    /// criterion = "distance"：t 为合并距离阈值（闭区间，dist &lt;= t 的合并都执行）。
    /// criterion = "maxclust"：t 为最大簇数（向下取整）。
    /// </summary>
    public static int[] Fcluster(double[,] Z, double t, string criterion = "distance")
    {
        if (Z == null) throw new ArgumentNullException(nameof(Z));
        int rows = Z.GetLength(0);
        int n = rows + 1;
        int maxId = 2 * n - 1;

        int[] parent = new int[maxId];
        for (int i = 0; i < maxId; i++) parent[i] = i;

        int Find(int a)
        {
            while (parent[a] != a) { parent[a] = parent[parent[a]]; a = parent[a]; }
            return a;
        }
        void Union(int a, int b)
        {
            int ra = Find(a), rb = Find(b);
            if (ra != rb) parent[rb] = ra;
        }

        string c = criterion.ToLowerInvariant();
        double threshold;

        if (c == "distance")
        {
            threshold = t;
        }
        else if (c == "maxclust")
        {
            int k = (int)Math.Floor(t);
            if (k <= 1)
            {
                threshold = double.PositiveInfinity;   // 全部合并
            }
            else if (k >= n)
            {
                threshold = double.NegativeInfinity;   // 都不合并
            }
            else
            {
                int needMerge = n - k;                 // 至少需合并次数
                var order = Enumerable.Range(0, rows).OrderBy(i => Z[i, 2]).ToArray();
                threshold = Z[order[needMerge - 1], 2];
            }
        }
        else
        {
            throw new ArgumentException($"不支持的 criterion: {criterion}");
        }

        for (int i = 0; i < rows; i++)
            if (Z[i, 2] <= threshold)
                Union((int)Z[i, 0], (int)Z[i, 1]);

        // 按叶节点顺序 0..n-1 重新编号 1..k
        var map = new Dictionary<int, int>();
        int[] labels = new int[n];
        int next = 1;
        for (int i = 0; i < n; i++)
        {
            int r = Find(i);
            if (!map.TryGetValue(r, out int lab))
            {
                lab = next++;
                map[r] = lab;
            }
            labels[i] = lab;
        }
        return labels;
    }
/// <summary>
/// single linkage + 一维数据的 O(n log n) 版本，等价于通用版结果。
/// </summary>
public static double[,] LinkageSingle1D(double[] x)
{
    int n = x.Length;
    if (n < 2) throw new ArgumentException();

    // 排序得到相邻点对
    int[] idx = new int[n];
    for (int i = 0; i < n; i++) idx[i] = i;
    Array.Sort(idx, (i, j) => x[i].CompareTo(x[j]));

    var edges = new (double d, int a, int b)[n - 1];
    for (int k = 0; k < n - 1; k++)
    {
        int i = idx[k], j = idx[k + 1];
        edges[k] = (Math.Abs(x[i] - x[j]), Math.Min(i, j), Math.Max(i, j));
    }
    Array.Sort(edges, (p, q) => p.d.CompareTo(q.d));

    // 并查集：初始每个原始点自成一簇，根为自己
    int[] parent = new int[2 * n - 1];
    int[] size = new int[2 * n - 1];
    for (int i = 0; i < 2 * n - 1; i++) parent[i] = i;
    for (int i = 0; i < n; i++) size[i] = 1;

    int Find(int a)
    {
        while (parent[a] != a) { parent[a] = parent[parent[a]]; a = parent[a]; }
        return a;
    }

    var Z = new double[n - 1, 4];
    int step = 0;
    foreach (var (d, u, v) in edges)
    {
        int ra = Find(u), rb = Find(v);
        if (ra == rb) continue;                 // 一维 MST 下不会发生，但保留正确性

        int c = n + step;
        int lo = Math.Min(ra, rb), hi = Math.Max(ra, rb);
        // 用簇 id 的较小者作为"根"、并把新簇 id 作为新根
        parent[ra] = c;
        parent[rb] = c;
        size[c] = size[ra] + size[rb];

        Z[step, 0] = lo;
        Z[step, 1] = hi;
        Z[step, 2] = d;
        Z[step, 3] = size[c];
        step++;
    }
    return Z;
}

public static double[,] LinkageFast(double[] x, string method = "single")
{
    int n = x.Length;
    string m = method.ToLowerInvariant();
    
    // 一维距离矩阵
    int N = 2 * n - 1;
    double[] D = new double[N * N];  // 行主序
    int[] size = new int[N];
    
    for (int i = 0; i < n; i++)
    {
        size[i] = 1;
        for (int j = 0; j < n; j++)
            D[i * N + j] = Math.Abs(x[i] - x[j]);
    }
    
    // 最近邻缓存
    int[] nn = new int[N];
    double[] nnd = new double[N];
    // 初始化
    for (int i = 0; i < n; i++)
    {
        int best = -1; double bd = double.MaxValue;
        for (int j = 0; j < n; j++)
        {
            if (i == j) continue;
            double d = D[i * N + j];
            if (d < bd) { bd = d; best = j; }
        }
        nn[i] = best; nnd[i] = bd;
    }
    
    // 最小堆
    var heap = new PriorityQueue<int, double>();
    for (int i = 0; i < n; i++) heap.Enqueue(i, nnd[i]);
    
    bool[] active = new bool[N];
    for (int i = 0; i < n; i++) active[i] = true;
    
    double[,] Z = new double[n - 1, 4];
    
    for (int step = 0; step < n - 1; step++)
    {
        // 弹出有效最小对
        int a = -1, b = -1; double dij = 0;
        while (heap.Count > 0)
        {
            heap.TryDequeue(out int i, out double d);
            if (!active[i]) continue;
            int j = nn[i];
            if (j < 0 || !active[j]) continue;
            if (d != nnd[i]) continue;  // 过期
            a = i; b = j; dij = d;
            break;
        }
        
        // 确保 a < b（scipy 规则）
        if (a > b) (a, b) = (b, a);
        
        int c = n + step;
        size[c] = size[a] + size[b];
        Z[step, 0] = a;
        Z[step, 1] = b;
        Z[step, 2] = dij;
        Z[step, 3] = size[c];
        
        int si = size[a], sj = size[b], sk = si + sj;
        
        // 更新 D[c, k] for all active k
        for (int k = 0; k < c; k++)
        {
            if (!active[k]) continue;
            double dki = D[k * N + a];
            double dkj = D[k * N + b];
            double dnew = Compute(m, dki, dkj, dij, si, sj, sk, size[k]);
            D[k * N + c] = dnew;
            D[c * N + k] = dnew;
        }
        
        active[a] = false; active[b] = false; active[c] = true;
        
        // 更新 nn/nnd
        // 先更新 nn[c]
        int cn = -1; double cnd = double.MaxValue;
        for (int k = 0; k < c; k++)
        {
            if (!active[k]) continue;
            double d = D[c * N + k];
            if (d < cnd) { cnd = d; cn = k; }
        }
        nn[c] = cn; nnd[c] = cnd;
        if (cn >= 0) heap.Enqueue(c, cnd);
        
        // 更新其他簇的 nn
        for (int k = 0; k < c; k++)
        {
            if (!active[k] || k == c) continue;
            double dkc = D[k * N + c];
            if (nn[k] == a || nn[k] == b)
            {
                // 需要重扫
                int bk = -1; double bd = double.MaxValue;
                for (int j = 0; j < c; j++)
                {
                    if (!active[j] || j == k) continue;
                    double d = D[k * N + j];
                    if (d < bd) { bd = d; bk = j; }
                }
                double d2 = dkc;
                if (d2 < bd) { bd = d2; bk = c; }
                nn[k] = bk; nnd[k] = bd;
                if (bk >= 0) heap.Enqueue(k, bd);
            }
            else if (dkc < nnd[k])
            {
                nn[k] = c; nnd[k] = dkc;
                heap.Enqueue(k, dkc);
            }
        }
    }
    return Z;
}

/// <summary>
/// 二叉最小堆：存 (int id, double priority)。C# 2.0+ 兼容。
/// </summary>
internal sealed class MinHeap
{
    private int[] _id;
    private double[] _pri;
    private int _count;

    public MinHeap(int capacity)
    {
        if (capacity < 4) capacity = 4;
        _id = new int[capacity];
        _pri = new double[capacity];
    }

    public int Count { get { return _count; } }

    public void Clear() { _count = 0; }

    private void EnsureCapacity()
    {
        if (_count < _id.Length) return;
        int nc = _id.Length * 2;
        int[] ni = new int[nc];
        double[] np = new double[nc];
        Array.Copy(_id, ni, _count);
        Array.Copy(_pri, np, _count);
        _id = ni;
        _pri = np;
    }

    public void Push(int id, double priority)
    {
        EnsureCapacity();
        int i = _count++;
        _id[i] = id;
        _pri[i] = priority;
        while (i > 0)
        {
            int p = (i - 1) >> 1;
            if (_pri[p] <= _pri[i]) break;
            Swap(i, p);
            i = p;
        }
    }

    public bool Pop(out int id, out double priority)
    {
        if (_count == 0) { id = -1; priority = 0.0; return false; }
        id = _id[0];
        priority = _pri[0];
        _count--;
        if (_count > 0)
        {
            _id[0] = _id[_count];
            _pri[0] = _pri[_count];
            int i = 0;
            while (true)
            {
                int l = 2 * i + 1;
                int r = l + 1;
                int s = i;
                if (l < _count && _pri[l] < _pri[s]) s = l;
                if (r < _count && _pri[r] < _pri[s]) s = r;
                if (s == i) break;
                Swap(i, s);
                i = s;
            }
        }
        return true;
    }

    private void Swap(int a, int b)
    {
        int ti = _id[a]; _id[a] = _id[b]; _id[b] = ti;
        double tp = _pri[a]; _pri[a] = _pri[b]; _pri[b] = tp;
    }
}

internal static double Compute(string m, double dki, double dkj, double dij,
                               int si, int sj, int sk, int skk)
{
    switch (m)
    {
        case "single":
            return (dki < dkj) ? dki : dkj;
        case "complete":
            return (dki > dkj) ? dki : dkj;
        case "average":
            return (si * dki + sj * dkj) / sk;
        case "weighted":
            return (dki + dkj) * 0.5;
        case "centroid":
            {
                double v = (si * dki * dki + sj * dkj * dkj) / sk
                         - ((double)si * sj * dij * dij) / ((double)sk * sk);
                return Math.Sqrt(v > 0.0 ? v : 0.0);
            }
        case "median":
            {
                double v = dki * dki * 0.5 + dkj * dkj * 0.5 - dij * dij * 0.25;
                return Math.Sqrt(v > 0.0 ? v : 0.0);
            }
        case "ward":
            {
                double num = (skk + si) * dki * dki
                           + (skk + sj) * dkj * dkj
                           - skk * dij * dij;
                double v = num / (skk + sk);
                return Math.Sqrt(v > 0.0 ? v : 0.0);
            }
        default:
            throw new ArgumentException("不支持的 method: " + m);
    }
}

