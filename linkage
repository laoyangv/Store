using System;
using System.Collections.Generic;
using System.Linq;

public static class HierarchicalClustering
{
   
    /// <summary>
    /// 切割层次聚类树，返回每个样本的簇标签（1 开始）。
    /// criterion = "distance"：t 为合并距离阈值（闭区间，dist &lt;= t 的合并都执行）。
    /// criterion = "maxclust"：t 为最大簇数（向下取整）。
    /// </summary>
    public static int[] Fcluster(double[,] Z, double t, string criterion = "distance")
    {
        if (Z == null) throw new ArgumentNullException(nameof(Z));
        int rows = Z.GetLength(0);
        int n = rows + 1;
        int maxId = 2 * n - 1;

        int[] parent = new int[maxId];
        for (int i = 0; i < maxId; i++) parent[i] = i;

        int Find(int a)
        {
            while (parent[a] != a) { parent[a] = parent[parent[a]]; a = parent[a]; }
            return a;
        }
        void Union(int a, int b)
        {
            int ra = Find(a), rb = Find(b);
            if (ra != rb) parent[rb] = ra;
        }

        string c = criterion.ToLowerInvariant();
        double threshold;

        if (c == "distance")
        {
            threshold = t;
        }
        else if (c == "maxclust")
        {
            int k = (int)Math.Floor(t);
            if (k <= 1)
            {
                threshold = double.PositiveInfinity;   // 全部合并
            }
            else if (k >= n)
            {
                threshold = double.NegativeInfinity;   // 都不合并
            }
            else
            {
                int needMerge = n - k;                 // 至少需合并次数
                var order = Enumerable.Range(0, rows).OrderBy(i => Z[i, 2]).ToArray();
                threshold = Z[order[needMerge - 1], 2];
            }
        }
        else
        {
            throw new ArgumentException($"不支持的 criterion: {criterion}");
        }

        for (int i = 0; i < rows; i++)
            if (Z[i, 2] <= threshold)
                Union((int)Z[i, 0], (int)Z[i, 1]);

        // 按叶节点顺序 0..n-1 重新编号 1..k
        var map = new Dictionary<int, int>();
        int[] labels = new int[n];
        int next = 1;
        for (int i = 0; i < n; i++)
        {
            int r = Find(i);
            if (!map.TryGetValue(r, out int lab))
            {
                lab = next++;
                map[r] = lab;
            }
            labels[i] = lab;
        }
        return labels;
    }
/// <summary>
/// single linkage + 一维数据的 O(n log n) 版本，等价于通用版结果。
/// </summary>
public static double[,] LinkageSingle1D(double[] x)
{
    int n = x.Length;
    if (n < 2) throw new ArgumentException();

    // 排序得到相邻点对
    int[] idx = new int[n];
    for (int i = 0; i < n; i++) idx[i] = i;
    Array.Sort(idx, (i, j) => x[i].CompareTo(x[j]));

    var edges = new (double d, int a, int b)[n - 1];
    for (int k = 0; k < n - 1; k++)
    {
        int i = idx[k], j = idx[k + 1];
        edges[k] = (Math.Abs(x[i] - x[j]), Math.Min(i, j), Math.Max(i, j));
    }
    Array.Sort(edges, (p, q) => p.d.CompareTo(q.d));

    // 并查集：初始每个原始点自成一簇，根为自己
    int[] parent = new int[2 * n - 1];
    int[] size = new int[2 * n - 1];
    for (int i = 0; i < 2 * n - 1; i++) parent[i] = i;
    for (int i = 0; i < n; i++) size[i] = 1;

    int Find(int a)
    {
        while (parent[a] != a) { parent[a] = parent[parent[a]]; a = parent[a]; }
        return a;
    }

    var Z = new double[n - 1, 4];
    int step = 0;
    foreach (var (d, u, v) in edges)
    {
        int ra = Find(u), rb = Find(v);
        if (ra == rb) continue;                 // 一维 MST 下不会发生，但保留正确性

        int c = n + step;
        int lo = Math.Min(ra, rb), hi = Math.Max(ra, rb);
        // 用簇 id 的较小者作为"根"、并把新簇 id 作为新根
        parent[ra] = c;
        parent[rb] = c;
        size[c] = size[ra] + size[rb];

        Z[step, 0] = lo;
        Z[step, 1] = hi;
        Z[step, 2] = d;
        Z[step, 3] = size[c];
        step++;
    }
    return Z;
}



}
